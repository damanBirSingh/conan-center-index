diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6c03482..684c721 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -229,6 +229,52 @@ if(ZLIB_BUILD_STATIC)
                                                      z${zlib_static_suffix})
 endif(ZLIB_BUILD_STATIC)
 
+# ============================================================================
+# zlibwapi (WINAPI/stdcall variant).
+#
+# Builds "zlibwapi.dll", the stdcall-calling-convention variant of the zlib
+# DLL historically produced by the (now-removed) contrib/vstudio/zlibvc.sln.
+# Same sources as the default shared library, compiled with ZLIB_WINAPI so the
+# exported functions use the WINAPI (stdcall) calling convention.
+# Windows-only, opt-in via -DZLIB_BUILD_WINAPI=ON (default OFF).
+# ============================================================================
+option(ZLIB_BUILD_WINAPI "Build the WINAPI/stdcall zlibwapi.dll (Windows only)" OFF)
+
+if(WIN32 AND ZLIB_BUILD_WINAPI)
+    add_library(
+        zlibwapi SHARED ${ZLIB_SRCS} ${ZLIB_PUBLIC_HDRS} ${ZLIB_PRIVATE_HDRS}
+                        $<$<OR:$<BOOL:${WIN32}>,$<BOOL:${CYGWIN}>>:win32/zlib1.rc>)
+    add_library(ZLIB::zlibwapi ALIAS zlibwapi)
+    target_include_directories(
+        zlibwapi
+        PUBLIC $<BUILD_INTERFACE:${zlib_BINARY_DIR}>
+               $<BUILD_INTERFACE:${zlib_SOURCE_DIR}>
+               $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>)
+    target_compile_definitions(
+        zlibwapi
+        PRIVATE ZLIB_BUILD
+                $<$<BOOL:NOT:${HAVE_FSEEKO}>:NO_FSEEKO>
+                $<$<BOOL:${HAVE___ATTR__VIS_HIDDEN}>:HAVE_HIDDEN>
+                $<$<BOOL:${MSVC}>:_CRT_SECURE_NO_DEPRECATE>
+                $<$<BOOL:${MSVC}>:_CRT_NONSTDC_NO_DEPRECATE>
+        PUBLIC $<$<BOOL:${HAVE_OFF64_T}>:_LARGEFILE64_SOURCE=1>
+               ZLIB_WINAPI)
+    set_target_properties(
+        zlibwapi
+        PROPERTIES DEFINE_SYMBOL ZLIB_DLL
+                   WINDOWS_EXPORT_ALL_SYMBOLS TRUE
+                   EXPORT_NAME zlibwapi
+                   OUTPUT_NAME zlibwapi)
+    if(ZLIB_INSTALL)
+        install(
+            TARGETS zlibwapi
+            COMPONENT Runtime
+            RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}"
+            ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}"
+            LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}")
+    endif(ZLIB_INSTALL)
+endif()
+
 if(ZLIB_INSTALL)
     if(ZLIB_BUILD_SHARED)
         install(
